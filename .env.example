# HTTP API
PORT=3000

# Where tenant data, call transcripts and customer requests are stored.
# Defaults to ./data relative to the project root.
DATA_DIR=./data

# Catalog source for the HTTP API: json | supabase.
# Enable supabase after adding your private server key below.
CATALOG_SOURCE=json
SUPABASE_URL=https://lzongluhbmyasadscuri.supabase.co
SUPABASE_TENANT_ID=demo-tire
# Server-only key. Never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe publishable key used by auth.html and app.html (Supabase Auth + RLS).
# It is public by design, but keep the secret key out of the browser.
SUPABASE_PUBLISHABLE_KEY=
# Password for the /admin.html dashboard. Use a long random value in production.
ADMIN_KEY=

# ---------------------------------------------------------------------------
# Future integrations. The current MVP runs fully in mock mode and does not
# need any of these. Keep real keys out of git.
# ---------------------------------------------------------------------------
# AI_PROVIDER=mock            # mock | openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
#
# TELEPHONY_PROVIDER=mock     # mock | twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
